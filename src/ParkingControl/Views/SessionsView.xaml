<UserControl x:Class="ParkingControl.Views.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <TextBox x:Name="SearchBox" Width="250" Margin="0,0,8,0"/>
            <Button Content="Поиск" Padding="10,4" Margin="0,0,8,0" Click="Search_Click"/>
            <CheckBox x:Name="OnlyActiveCheck" Content="Только активные"
                      VerticalAlignment="Center" Margin="8,0,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Автомобиль:" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="VehicleCombo" Margin="4"
                      DisplayMemberPath="PlateNumber" SelectedValuePath="VehicleId"/>
            <TextBlock Grid.Column="2" Text="Место:" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="3" x:Name="SpaceCombo" Margin="4"
                      DisplayMemberPath="SpaceNumber" SelectedValuePath="SpaceId"/>
            <TextBlock Grid.Column="4" Text="Тариф:" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="5" x:Name="TariffCombo" Margin="4"
                      DisplayMemberPath="Name" SelectedValuePath="TariffId"/>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="EmptyMessage" Text="Ничего не найдено"
                   Foreground="Gray" Visibility="Collapsed" Margin="0,0,0,6"/>

        <DataGrid Grid.Row="3" x:Name="Grid" AutoGenerateColumns="True" IsReadOnly="True"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Открыть сессию" Padding="10,4" Margin="0,0,8,0" Click="Open_Click"/>
            <Button Content="Закрыть сессию" Padding="10,4" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</UserControl>