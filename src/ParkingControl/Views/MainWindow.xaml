<Window x:Class="ParkingControl.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ParkingControl" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#2C3E50">
            <Button Content="Клиенты" Margin="6" Padding="12,6" Click="Clients_Click"/>
            <Button Content="Автомобили" Margin="6" Padding="12,6" Click="Vehicles_Click"/>
            <Button Content="Сессии" Margin="6" Padding="12,6" Click="Sessions_Click"/>
            <Button Content="Отчёт" Margin="6" Padding="12,6" Click="Report_Click"/>
        </StackPanel>
        <ContentControl x:Name="Host"/>
    </DockPanel>
</Window>