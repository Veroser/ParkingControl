<UserControl x:Class="ParkingControl.Views.VehiclesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <TextBox x:Name="SearchBox" Width="250" Margin="0,0,8,0"/>
            <Button Content="Поиск" Padding="10,4" Click="Search_Click"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Клиент:" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="ClientCombo" Margin="4"
                      DisplayMemberPath="FullName" SelectedValuePath="ClientId"/>
            <TextBlock Grid.Column="2" Text="Госномер:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="3" x:Name="PlateBox" Margin="4"/>
            <TextBlock Grid.Column="4" Text="Модель:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="5" x:Name="ModelBox" Margin="4"/>
        </Grid>

        <DataGrid Grid.Row="2" x:Name="Grid" AutoGenerateColumns="True" IsReadOnly="True"
                  SelectionChanged="Grid_SelectionChanged"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Добавить" Padding="10,4" Margin="0,0,8,0" Click="Add_Click"/>
            <Button Content="Обновить" Padding="10,4" Margin="0,0,8,0" Click="Update_Click"/>
            <Button Content="Удалить" Padding="10,4" Click="Delete_Click"/>
        </StackPanel>
    </Grid>
</UserControl>